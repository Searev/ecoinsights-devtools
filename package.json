{
  "name": "ecoinsights-profiler",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run build:app && npm run build:scripts",
    "build:app": "vite build --base=./",
    "build:scripts": "esbuild ./src/scripts/*.ts --bundle --minify --outdir=./dist/scripts",
    "build:firefox": "npm run build && node build-finalizer -firefox",
    "build:chrome": "npm run build && node build-finalizer -chrome",
    "serve": "vite preview"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.248",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "autoprefixer": "^10.4.16",
    "chrome-types": "^0.1.234",
    "ecoindex_reference": "github:cnumr/ecoindex_reference#main",
    "eslint": "^8.51.0",
    "eslint-plugin-solid": "^0.13.0",
    "postcss": "^8.4.31",
    "solid-devtools": "^0.27.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-solid": "^2.7.0"
  },
  "dependencies": {
    "@solid-primitives/refs": "^1.0.5",
    "@solidjs/router": "^0.8.3",
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "solid-chartjs": "^1.3.8",
    "solid-js": "^1.7.6"
  }
}

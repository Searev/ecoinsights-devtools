{
  "name": "ecoinsights-profiler",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "lint:firefox": "npx --yes web-ext lint -s dist/firefox",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.248",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "^6.8.0",
    "@typescript-eslint/parser": "^6.8.0",
    "autoprefixer": "^10.4.16",
    "chrome-types": "^0.1.234",
    "ecoindex_reference": "github:cnumr/ecoindex_reference#main",
    "eslint": "^8.51.0",
    "eslint-plugin-solid": "^0.13.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.31",
    "solid-devtools": "^0.27.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.3",
    "vite": "^4.3.9",
    "vite-plugin-solid": "^2.7.0",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@solid-primitives/refs": "^1.0.5",
    "@solidjs/router": "^0.8.3",
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "solid-chartjs": "^1.3.8",
    "solid-js": "^1.7.6"
  }
}

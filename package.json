{
  "name": "ecoinsights-devtools",
  "version": "1.0.0",
  "description": "Extension DevTools (Chrome, Firefox) qui mesure l'impact environnemental d'un parcours utilisateur et vérifie les bonnes pratiques d'écoconception web.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "lint:firefox": "npx --yes web-ext lint -s dist/firefox",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/chrome": "0.0.332",
    "@types/node": "20.8.10",
    "@typescript-eslint/eslint-plugin": "6.8.0",
    "@typescript-eslint/parser": "6.8.0",
    "autoprefixer": "10.4.27",
    "chrome-types": "0.1.459",
    "ecoindex_reference": "github:cnumr/ecoindex_reference#main",
    "eslint": "8.51.0",
    "eslint-plugin-solid": "0.13.0",
    "jsdom": "22.1.0",
    "postcss": "8.4.49",
    "solid-devtools": "0.27.9",
    "tailwindcss": "3.3.7",
    "typescript": "5.2.2",
    "vite": "4.5.14",
    "vite-plugin-solid": "2.7.2",
    "vitest": "0.34.6"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@solid-primitives/refs": "1.0.8",
    "@solidjs/router": "0.8.4",
    "chart.js": "4.4.9",
    "chartjs-adapter-date-fns": "3.0.0",
    "solid-chartjs": "1.3.11",
    "solid-js": "1.9.6"
  },
  "overrides": {
    "babel-preset-solid": "1.9.6"
  }
}
